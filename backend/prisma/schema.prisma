// Prisma Schema para Sistema Integral de Gestión de Maestros
// Bolivia - Multi-Tenant con PostgreSQL Row-Level Security (RLS)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS GLOBALES E INSTITUCIONALES
// -------------------------------------------------------------

enum RolGlobal {
  SUPERADMIN
  CENTRAL_ADMIN
  INSTITUTIONAL_USER
}

enum RolInstitucional {
  ADMIN_INSTITUCIONAL
  DIRECTOR
  SECRETARIO
  MAESTRO
  COMISION_PEDAGOGICA
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
  BLOQUEADO
}

enum EstadoVinculacion {
  ACTIVO
  INACTIVO
  LICENCIA
  TRASLADADO
}

enum TipoInstitucion {
  FISCAL
  CONVENIO
  PRIVADA
}

enum NivelEducativo {
  INICIAL
  PRIMARIA
  SECUNDARIA
  INTEGRADO
}

enum TipoAuditoria {
  LOGIN_SUCCESS
  LOGIN_FAILED
  CONTEXT_SWITCH
  SECURITY_VIOLATION
  USER_CREATE
  USER_UPDATE
  TEACHER_LINK
  TEACHER_UNLINK
}

enum EstadoGestion {
  EN_PLANIFICACION
  ABIERTA
  CERRADA
}

enum Turno {
  MANANA
  TARDE
  NOCHE
}

enum CampoSaberes {
  COSMOS_Y_PENSAMIENTO
  COMUNIDAD_Y_SOCIEDAD
  VIDA_TIERRA_TERRITORIO
  CIENCIA_TECNOLOGIA_PRODUCCION
}

enum EstadoAsignacion {
  ACTIVA
  SUSPENDIDA
  FINALIZADA
}

enum ParentescoTutor {
  PADRE
  MADRE
  TUTOR_LEGAL
  ABUELO
  HERMANO
  OTRO
}

enum EstadoInscripcion {
  EFECTIVO
  RETIRADO_TRASLADO
  RETIRADO_ABANDONO
  NO_INCORPORADO
}

enum SituacionFinalEstudiante {
  PROMOVIDO
  RETENIDO
}

enum EstadoAsistencia {
  PRESENTE
  FALTA
  LICENCIA
  ATRASO
}

enum TipoPeriodo {
  PRIMER_TRIMESTRE
  SEGUNDO_TRIMESTRE
  TERCER_TRIMESTRE
}

enum EstadoPeriodo {
  PROGRAMADO
  ABIERTO
  CERRADO
}

enum DimensionEvaluacion {
  SER
  SABER
  HACER
  DECIDIR
  AUTOEVALUACION
  PUNTOS_EXTRAS
}

// -------------------------------------------------------------
// MODELO DE IDENTIDAD CENTRALIZADA
// -------------------------------------------------------------

model Persona {
  id              String    @id @default(uuid()) @db.Uuid
  ci              String    @unique @db.VarChar(20)
  complemento     String?   @db.VarChar(10)
  nombres         String    @db.VarChar(100)
  primerApellido  String    @db.VarChar(100)
  segundoApellido String?   @db.VarChar(100)
  fechaNacimiento DateTime? @db.Date
  genero          String?   @db.VarChar(10)
  direccion       String?   @db.VarChar(255)
  telefono        String?   @db.VarChar(20)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  usuario Usuario?
  maestro Maestro?
  estudiante Estudiante?

  @@index([ci])
  @@map("personas")
}

model Usuario {
  id           String        @id @default(uuid()) @db.Uuid
  personaId    String        @unique @map("persona_id") @db.Uuid
  email        String        @unique @db.VarChar(255)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  rolGlobal    RolGlobal     @default(INSTITUTIONAL_USER) @map("rol_global")
  estado       EstadoUsuario @default(ACTIVO)
  ultimoAcceso DateTime?     @map("ultimo_acceso")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  persona                Persona                   @relation(fields: [personaId], references: [id], onDelete: Cascade)
  vinculaciones          VinculacionInstitucional[]
  refreshTokens          RefreshToken[]
  auditorias             RegistroAuditoria[]
  asistenciasRegistradas RegistroAsistencia[]
  kardexRegistrados      RegistroKardex[]

  @@index([email])
  @@map("usuarios")
}

model Maestro {
  id                String   @id @default(uuid()) @db.Uuid
  personaId         String   @unique @map("persona_id") @db.Uuid
  rda               String   @unique @db.VarChar(50)
  tituloProfesional String?  @map("titulo_profesional") @db.VarChar(255)
  especialidad      String?  @db.VarChar(255)
  anioEgreso        Int?     @map("anio_egreso")
  normalista        Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  persona       Persona                   @relation(fields: [personaId], references: [id], onDelete: Cascade)
  vinculaciones VinculacionInstitucional[]

  @@index([rda])
  @@map("maestros")
}

// -------------------------------------------------------------
// MODELO INSTITUCIONAL Y MULTI-TENANT
// -------------------------------------------------------------

model UnidadEducativa {
  id           String          @id @default(uuid()) @db.Uuid
  sie          String          @unique @db.VarChar(20)
  nombre       String          @db.VarChar(255)
  departamento String          @db.VarChar(50)
  provincia    String          @db.VarChar(100)
  municipio    String          @db.VarChar(100)
  distrito     String?         @db.VarChar(100)
  direccion    String?         @db.VarChar(255)
  telefono     String?         @db.VarChar(20)
  tipo         TipoInstitucion @default(FISCAL)
  nivel        NivelEducativo  @default(INTEGRADO)
  activo       Boolean         @default(true)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  vinculaciones VinculacionInstitucional[]
  gestiones     GestionEscolar[]
  paralelos     Paralelo[]
  asignaciones  AsignacionAcademica[]
  inscripciones      Inscripcion[]
  asistencias        RegistroAsistencia[]
  periodosEvaluacion PeriodoEvaluacion[]
  evaluaciones       Evaluacion[]
  calificaciones     Calificacion[]
  auditorias         RegistroAuditoria[]
  registrosKardex    RegistroKardex[]
  horariosPeriodos   HorarioPeriodo[]
  suscripcion        SuscripcionInstitucion?

  @@index([sie])
  @@index([departamento])
  @@map("unidades_educativas")
}

model VinculacionInstitucional {
  id               String            @id @default(uuid()) @db.Uuid
  institucionId    String            @map("institucion_id") @db.Uuid
  maestroId        String?           @map("maestro_id") @db.Uuid
  usuarioId        String            @map("usuario_id") @db.Uuid
  rolInstitucional RolInstitucional  @map("rol_institucional")
  cargoOficial     String?           @map("cargo_oficial") @db.VarChar(150)
  fechaInicio      DateTime          @default(now()) @map("fecha_inicio") @db.Date
  fechaFin         DateTime?         @map("fecha_fin") @db.Date
  estado           EstadoVinculacion @default(ACTIVO)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  institucion UnidadEducativa @relation(fields: [institucionId], references: [id], onDelete: Cascade)
  maestro     Maestro?        @relation(fields: [maestroId], references: [id], onDelete: SetNull)
  usuario     Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  asignaciones AsignacionAcademica[]

  @@unique([institucionId, usuarioId, rolInstitucional])
  @@index([institucionId])
  @@index([usuarioId])
  @@index([maestroId])
  @@map("vinculaciones_institucionales")
}

// -------------------------------------------------------------
// ESTRUCTURA ACADÉMICA (GESTIONES, CURSOS, PARALELOS Y MATERIAS)
// -------------------------------------------------------------

model GestionEscolar {
  id            String        @id @default(uuid()) @db.Uuid
  institucionId String        @map("institucion_id") @db.Uuid
  anio          Int
  fechaInicio   DateTime      @map("fecha_inicio") @db.Date
  fechaFin      DateTime?     @map("fecha_fin") @db.Date
  estado        EstadoGestion @default(EN_PLANIFICACION)
  activo        Boolean       @default(true)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  institucion   UnidadEducativa       @relation(fields: [institucionId], references: [id], onDelete: Cascade)
  paralelos     Paralelo[]
  asignaciones  AsignacionAcademica[]
  inscripciones Inscripcion[]
  periodos      PeriodoEvaluacion[]

  @@unique([institucionId, anio])
  @@index([institucionId])
  @@map("gestiones_escolares")
}

model Curso {
  id        String         @id @default(uuid()) @db.Uuid
  nivel     NivelEducativo
  grado     Int
  nombre    String         @db.VarChar(100)
  orden     Int

  paralelos Paralelo[]

  @@unique([nivel, grado])
  @@map("cursos")
}

model Materia {
  id        String         @id @default(uuid()) @db.Uuid
  codigo    String         @unique @db.VarChar(30)
  nombre    String         @db.VarChar(150)
  campo     CampoSaberes
  nivel     NivelEducativo
  esTroncal Boolean        @default(true) @map("es_troncal")
  orden     Int            @default(0)
  asignaciones AsignacionAcademica[]

  @@index([nivel])
  @@index([campo])
  @@map("materias")
}

model Paralelo {
  id            String   @id @default(uuid()) @db.Uuid
  institucionId String   @map("institucion_id") @db.Uuid
  gestionId     String   @map("gestion_id") @db.Uuid
  cursoId       String   @map("curso_id") @db.Uuid
  letra         String   @db.VarChar(5)
  turno         Turno    @default(MANANA)
  cupoMaximo    Int      @default(35) @map("cupo_maximo")
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institucion UnidadEducativa @relation(fields: [institucionId], references: [id], onDelete: Cascade)
  gestion     GestionEscolar  @relation(fields: [gestionId], references: [id], onDelete: Cascade)
  curso       Curso           @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  asignaciones AsignacionAcademica[]
  inscripciones Inscripcion[]
  asistencias   RegistroAsistencia[]

  @@unique([gestionId, cursoId, letra, turno])
  @@index([institucionId])
  @@index([gestionId])
  @@index([cursoId])
  @@map("paralelos")
}

// -------------------------------------------------------------
// SESIONES, TOKENS Y AUDITORÍA
// -------------------------------------------------------------

model AsignacionAcademica {
  id              String           @id @default(uuid()) @db.Uuid
  institucionId   String           @map("institucion_id") @db.Uuid
  gestionId       String           @map("gestion_id") @db.Uuid
  vinculacionId   String           @map("vinculacion_id") @db.Uuid
  paraleloId      String           @map("paralelo_id") @db.Uuid
  materiaId       String           @map("materia_id") @db.Uuid
  horasSemanales  Int              @default(4) @map("horas_semanales")
  esTitular       Boolean          @default(true) @map("es_titular")
  esTutor         Boolean          @default(false) @map("es_tutor")
  estado          EstadoAsignacion @default(ACTIVA)
  fechaAsignacion DateTime         @default(now()) @map("fecha_asignacion")
  activo          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  institucion  UnidadEducativa          @relation(fields: [institucionId], references: [id], onDelete: Cascade)
  gestion      GestionEscolar           @relation(fields: [gestionId], references: [id], onDelete: Cascade)
  vinculacion  VinculacionInstitucional @relation(fields: [vinculacionId], references: [id], onDelete: Cascade)
  paralelo     Paralelo                 @relation(fields: [paraleloId], references: [id], onDelete: Cascade)
  materia      Materia                  @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  asistencias      RegistroAsistencia[]
  evaluaciones     Evaluacion[]
  horariosPeriodos HorarioPeriodo[]

  @@unique([gestionId, paraleloId, materiaId, vinculacionId])
  @@index([institucionId])
  @@index([gestionId])
  @@index([vinculacionId])
  @@index([paraleloId])
  @@index([materiaId])
  @@map("asignaciones_academicas")
}

// -------------------------------------------------------------
// ESTUDIANTES Y MATRICULACIÓN ESCOLAR (FEATURE 006)
// -------------------------------------------------------------

model Estudiante {
  id              String           @id @default(uuid()) @db.Uuid
  personaId       String           @unique @map("persona_id") @db.Uuid
  codigoRude      String           @unique @map("codigo_rude") @db.VarChar(50)
  nombreTutor     String?          @map("nombre_tutor") @db.VarChar(150)
  ciTutor         String?          @map("ci_tutor") @db.VarChar(20)
  parentescoTutor ParentescoTutor? @default(PADRE) @map("parentesco_tutor")
  telefonoTutor   String?          @map("telefono_tutor") @db.VarChar(30)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  persona            Persona             @relation(fields: [personaId], references: [id], onDelete: Cascade)
  inscripciones      Inscripcion[]
  detallesAsistencia DetalleAsistencia[]
  calificaciones     Calificacion[]
  registrosKardex    RegistroKardex[]

  @@index([codigoRude])
  @@map("estudiantes")
}

// -------------------------------------------------------------
// CONTROL DE ASISTENCIA Y JUSTIFICACIONES (FEATURE 007)
// -------------------------------------------------------------

model RegistroAsistencia {
  id              String   @id @default(uuid()) @db.Uuid
  institucionId   String   @map("institucion_id") @db.Uuid
  paraleloId      String   @map("paralelo_id") @db.Uuid
  asignacionId    String?  @map("asignacion_id") @db.Uuid
  registradoPorId String   @map("registrado_por_id") @db.Uuid
  fecha           DateTime @db.Date
  observaciones   String?  @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  institucion   UnidadEducativa      @relation(fields: [institucionId], references: [id], onDelete: Cascade)
  paralelo      Paralelo             @relation(fields: [paraleloId], references: [id], onDelete: Cascade)
  asignacion    AsignacionAcademica? @relation(fields: [asignacionId], references: [id], onDelete: SetNull)
  registradoPor Usuario              @relation(fields: [registradoPorId], references: [id], onDelete: Restrict)
  detalles      DetalleAsistencia[]

  @@unique([paraleloId, fecha, asignacionId])
  @@index([institucionId])
  @@index([paraleloId])
  @@index([fecha])
  @@index([asignacionId])
  @@map("registros_asistencia")
}

model DetalleAsistencia {
  id                   String           @id @default(uuid()) @db.Uuid
  registroAsistenciaId String           @map("registro_asistencia_id") @db.Uuid
  estudianteId         String           @map("estudiante_id") @db.Uuid
  estado               EstadoAsistencia @default(PRESENTE)
  justificado          Boolean          @default(false)
  observacion          String?          @db.VarChar(255)

  registroAsistencia RegistroAsistencia @relation(fields: [registroAsistenciaId], references: [id], onDelete: Cascade)
  estudiante         Estudiante         @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@unique([registroAsistenciaId, estudianteId])
  @@index([registroAsistenciaId])
  @@index([estudianteId])
  @@map("detalles_asistencia")
}

model Inscripcion {
  id               String            @id @default(uuid()) @db.Uuid
  institucionId    String            @map("institucion_id") @db.Uuid
  estudianteId     String            @map("estudiante_id") @db.Uuid
  gestionId        String            @map("gestion_id") @db.Uuid
  paraleloId       String            @map("paralelo_id") @db.Uuid
  estado           EstadoInscripcion         @default(EFECTIVO)
  esRepitente      Boolean                   @default(false) @map("es_repitente")
  promedioAnual    Float?                    @map("promedio_anual")
  situacionFinal   SituacionFinalEstudiante? @map("situacion_final")
  observaciones    String?                   @db.VarChar(255)
  fechaInscripcion DateTime          @default(now()) @map("fecha_inscripcion")
  activo           Boolean           @default(true)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  institucion UnidadEducativa @relation(fields: [institucionId], references: [id], onDelete: Cascade)
  estudiante  Estudiante      @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  gestion     GestionEscolar  @relation(fields: [gestionId], references: [id], onDelete: Cascade)
  paralelo    Paralelo        @relation(fields: [paraleloId], references: [id], onDelete: Cascade)

  @@unique([gestionId, estudianteId])
  @@index([institucionId])
  @@index([estudianteId])
  @@index([gestionId])
  @@index([paraleloId])
  @@map("inscripciones")
}

model RefreshToken {
  id               String    @id @default(uuid()) @db.Uuid
  usuarioId        String    @map("usuario_id") @db.Uuid
  tokenHash        String    @map("token_hash") @db.VarChar(255)
  expiresAt        DateTime  @map("expires_at")
  revoked          Boolean   @default(false)
  createdAt        DateTime  @default(now()) @map("created_at")
  replacedByToken  String?   @map("replaced_by_token") @db.VarChar(255)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model RegistroAuditoria {
  id            String        @id @default(uuid()) @db.Uuid
  usuarioId     String?       @map("usuario_id") @db.Uuid
  institucionId String?       @map("institucion_id") @db.Uuid
  tipo          TipoAuditoria
  accion        String        @db.VarChar(100)
  detalle       Json?
  ip            String?       @db.VarChar(45)
  userAgent     String?       @map("user_agent") @db.VarChar(255)
  timestamp     DateTime      @default(now())

  usuario     Usuario?         @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  institucion UnidadEducativa? @relation(fields: [institucionId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([institucionId])
  @@index([tipo])
  @@index([timestamp])
  @@map("registros_auditoria")
}

// -------------------------------------------------------------
// EVALUACIONES Y PERIODOS EVALUATIVOS (FEATURE 008)
// -------------------------------------------------------------

model PeriodoEvaluacion {
  id               String        @id @default(uuid()) @db.Uuid
  institucionId    String        @map("institucion_id") @db.Uuid
  gestionId        String        @map("gestion_id") @db.Uuid
  periodo          TipoPeriodo
  fechaInicio      DateTime      @map("fecha_inicio") @db.Date
  fechaFin         DateTime      @map("fecha_fin") @db.Date
  fechaLimiteNotas DateTime      @map("fecha_limite_notas") @db.Date
  estado           EstadoPeriodo @default(PROGRAMADO)
  activo           Boolean       @default(true)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  institucion  UnidadEducativa @relation(fields: [institucionId], references: [id], onDelete: Cascade)
  gestion      GestionEscolar  @relation(fields: [gestionId], references: [id], onDelete: Cascade)
  evaluaciones Evaluacion[]

  @@unique([gestionId, periodo])
  @@index([institucionId])
  @@index([gestionId])
  @@index([estado])
  @@map("periodos_evaluacion")
}

model Evaluacion {
  id              String              @id @default(uuid()) @db.Uuid
  institucionId   String              @map("institucion_id") @db.Uuid
  asignacionId    String              @map("asignacion_id") @db.Uuid
  periodoId       String              @map("periodo_id") @db.Uuid
  dimension       DimensionEvaluacion
  nombre          String              @db.VarChar(150)
  descripcion     String?             @db.VarChar(255)
  puntajeMaximo   Int                 @map("puntaje_maximo")
  fechaEvaluacion DateTime            @map("fecha_evaluacion") @db.Date
  activo          Boolean             @default(true)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  institucion    UnidadEducativa     @relation(fields: [institucionId], references: [id], onDelete: Cascade)
  asignacion     AsignacionAcademica @relation(fields: [asignacionId], references: [id], onDelete: Cascade)
  periodo        PeriodoEvaluacion   @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  calificaciones Calificacion[]

  @@index([institucionId])
  @@index([asignacionId])
  @@index([periodoId])
  @@index([dimension])
  @@index([fechaEvaluacion])
  @@map("evaluaciones")
}

// -------------------------------------------------------------
// REGISTRO DE CALIFICACIONES (FEATURE 009)
// -------------------------------------------------------------

model Calificacion {
  id            String   @id @default(uuid()) @db.Uuid
  institucionId String   @map("institucion_id") @db.Uuid
  evaluacionId  String   @map("evaluacion_id") @db.Uuid
  estudianteId  String   @map("estudiante_id") @db.Uuid
  nota          Int
  observacion   String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institucion UnidadEducativa @relation(fields: [institucionId], references: [id], onDelete: Cascade)
  evaluacion  Evaluacion      @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)
  estudiante  Estudiante      @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@unique([evaluacionId, estudianteId])
  @@index([institucionId])
  @@index([evaluacionId])
  @@index([estudianteId])
  @@map("calificaciones")
}

// -------------------------------------------------------------
// SEGUIMIENTO DISCIPLINARIO Y KARDEX PEDAGÓGICO (HOJA KARDEX)
// -------------------------------------------------------------

model RegistroKardex {
  id              String   @id @default(uuid()) @db.Uuid
  institucionId   String   @map("institucion_id") @db.Uuid
  estudianteId    String   @map("estudiante_id") @db.Uuid
  registradoPorId String   @map("registrado_por_id") @db.Uuid
  fecha           DateTime @db.Date

  // 1. Asistencia
  faltaConLicencia     Boolean @default(false) @map("falta_con_licencia")
  faltaSinLicencia     Boolean @default(false) @map("falta_sin_licencia")
  fueraDeHorario       Boolean @default(false) @map("fuera_de_horario")
  abandonoClase        Boolean @default(false) @map("abandono_clase")

  // 2. Responsabilidad
  noPresentoDeber        Boolean @default(false) @map("no_presento_deber")
  noDioEvaluacion        Boolean @default(false) @map("no_dio_evaluacion")
  noExpuso               Boolean @default(false) @map("no_expuso")
  noTrajoMateriales      Boolean @default(false) @map("no_trajo_materiales")
  danoMobiliario         Boolean @default(false) @map("dano_mobiliario")
  trajoCelularSinPermiso Boolean @default(false) @map("trajo_celular_sin_permiso")

  // 3. Participación
  noParticipa      Boolean @default(false) @map("no_participa")
  noPrestaAtencion Boolean @default(false) @map("no_presta_atencion")

  // 4. Conducta
  faltoRespetoDocente    Boolean @default(false) @map("falto_respeto_docente")
  faltoRespetoCompaneros Boolean @default(false) @map("falto_respeto_companeros")
  lenguajeInapropiado    Boolean @default(false) @map("lenguaje_inapropiado")

  observacionDetalle   String    @map("observacion_detalle") @db.VarChar(500)
  compromisoEstudiante String?   @map("compromiso_estudiante") @db.VarChar(500)
  citacionPadres       Boolean   @default(false) @map("citacion_padres")
  fechaCitacion        DateTime? @map("fecha_citacion") @db.Date
  horaCitacion         String?   @map("hora_citacion") @db.VarChar(10)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  institucion   UnidadEducativa @relation(fields: [institucionId], references: [id], onDelete: Cascade)
  estudiante    Estudiante      @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  registradoPor Usuario         @relation(fields: [registradoPorId], references: [id], onDelete: Restrict)

  @@index([institucionId])
  @@index([estudianteId])
  @@index([fecha])
  @@map("registros_kardex")
}

// -------------------------------------------------------------
// HORARIOS Y DISTRIBUCIÓN DE PERÍODOS DOCENTES (HOJA HOR)
// -------------------------------------------------------------

model HorarioPeriodo {
  id            String   @id @default(uuid()) @db.Uuid
  institucionId String   @map("institucion_id") @db.Uuid
  asignacionId  String   @map("asignacion_id") @db.Uuid
  diaSemana     Int      @map("dia_semana") // 1: Lunes, 2: Martes, 3: Miércoles, 4: Jueves, 5: Viernes, 6: Sábado
  periodo       Int      // 1 al 6
  horaInicio    String   @map("hora_inicio") @db.VarChar(5) // ej. "08:00"
  horaFin       String   @map("hora_fin") @db.VarChar(5)    // ej. "08:45"
  aula          String?  @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  institucion UnidadEducativa     @relation(fields: [institucionId], references: [id], onDelete: Cascade)
  asignacion  AsignacionAcademica @relation(fields: [asignacionId], references: [id], onDelete: Cascade)

  @@unique([asignacionId, diaSemana, periodo])
  @@index([institucionId])
  @@index([asignacionId])
  @@map("horarios_periodos")
}

// -------------------------------------------------------------
// MODELO SAAS: PLANES, SUSCRIPCIONES Y FACTURACIÓN
// -------------------------------------------------------------

enum EstadoSuscripcion {
  TRIAL
  ACTIVA
  GRACIA
  VENCIDA
  CANCELADA
}

enum PeriodoFacturacion {
  MENSUAL
  SEMESTRAL
  ANUAL
}

enum MetodoPagoSaaS {
  QR_SIMPLE
  TRANSFERENCIA_BANCARIA
  TARJETA_CREDITO_DEBITO
  MANUAL_ADMIN
}

enum EstadoPagoSaaS {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model PlanSuscripcion {
  id                        String                 @id @default(uuid()) @db.Uuid
  codigo                    String                 @unique @db.VarChar(50)
  nombre                    String                 @db.VarChar(100)
  descripcion               String                 @db.VarChar(255)
  precioMensual             Decimal                @map("precio_mensual") @db.Decimal(10, 2)
  precioAnual               Decimal                @map("precio_anual") @db.Decimal(10, 2)
  moneda                    String                 @default("BOB") @db.VarChar(10)
  maxEstudiantes            Int                    @default(100) @map("max_estudiantes")
  maxDocentes               Int                    @default(10) @map("max_docentes")
  permiteReportesOficiales   Boolean                @default(true) @map("permite_reportes_oficiales")
  permiteLogoPersonalizado   Boolean                @default(false) @map("permite_logo_personalizado")
  permiteKardexCompleto      Boolean                @default(false) @map("permite_kardex_completo")
  permiteSoportePrioritario  Boolean                @default(false) @map("permite_soporte_prioritario")
  activo                    Boolean                @default(true)
  orden                     Int                    @default(1)
  createdAt                 DateTime               @default(now()) @map("created_at")
  updatedAt                 DateTime               @updatedAt @map("updated_at")

  suscripciones SuscripcionInstitucion[]

  @@map("planes_suscripcion")
}

model SuscripcionInstitucion {
  id                 String             @id @default(uuid()) @db.Uuid
  institucionId      String             @unique @map("institucion_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  estado             EstadoSuscripcion  @default(TRIAL)
  periodoFacturacion PeriodoFacturacion @default(MENSUAL) @map("periodo_facturacion")
  fechaInicio        DateTime           @default(now()) @map("fecha_inicio")
  fechaFin           DateTime           @map("fecha_fin")
  diasGracia         Int                @default(5) @map("dias_gracia")
  autoRenovacion     Boolean            @default(true) @map("auto_renovacion")
  montoActual        Decimal            @default(0.00) @map("monto_actual") @db.Decimal(10, 2)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  institucion UnidadEducativa           @relation(fields: [institucionId], references: [id], onDelete: Cascade)
  plan        PlanSuscripcion           @relation(fields: [planId], references: [id], onDelete: Restrict)
  pagos       HistorialPagoSuscripcion[]

  @@index([institucionId])
  @@index([planId])
  @@index([estado])
  @@map("suscripciones_institucion")
}

model HistorialPagoSuscripcion {
  id                 String         @id @default(uuid()) @db.Uuid
  suscripcionId      String         @map("suscripcion_id") @db.Uuid
  monto              Decimal        @db.Decimal(10, 2)
  moneda             String         @default("BOB") @db.VarChar(10)
  metodoPago         MetodoPagoSaaS @default(QR_SIMPLE) @map("metodo_pago")
  estado             EstadoPagoSaaS @default(PENDIENTE)
  codigoTransaccion  String         @unique @map("codigo_transaccion") @db.VarChar(100)
  referenciaBancaria String?        @map("referencia_bancaria") @db.VarChar(100)
  comprobanteUrl     String?        @map("comprobante_url") @db.VarChar(255)
  fechaPago          DateTime?      @map("fecha_pago")
  observaciones      String?        @db.VarChar(255)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  suscripcion SuscripcionInstitucion @relation(fields: [suscripcionId], references: [id], onDelete: Cascade)

  @@index([suscripcionId])
  @@index([estado])
  @@map("historial_pagos_suscripcion")
}
