# =============================================================================
#  .env.example — Configuración del Sistema Integral de Gestión de Maestros
#  Metodología: Spec-Driven Development (SDD)
#  Constitución Referencia: V1.1.0
# =============================================================================

# --- Entorno de Ejecución ---
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# --- Base de Datos (PostgreSQL Multi-Tenant con RLS) ---
# Formato: postgresql://<usuario>:<contraseña>@<host>:<puerto>/<base_datos>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maestros_db?schema=public

# --- Autenticación y Tokens JWT (ADR-002) ---
JWT_SECRET=super_secret_jwt_signing_key_replace_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_replace_in_production_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# --- Seguridad de Password Hashing (Argon2id) ---
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# --- CORS y Orígenes Permitidos ---
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
